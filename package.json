{
  "name": "greenpax-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "check:bundle": "tsx src/scripts/checkBundleSize.ts",
    "start": "next start",
    "lint": "next lint",
    "test:contracts": "playwright test tests/contracts",
    "lighthouse:home:mobile": "node tests/tools/run-lighthouse-prod.js mobile",
    "lighthouse:home:desktop": "node tests/tools/run-lighthouse-prod.js desktop",
    "test:contract:home": "playwright test tests/contracts/home.contract.spec.ts",
    "report:contract:home": "tsx src/scripts/generateContractReport.ts",
    "test:smoke": "playwright test tests/smoke",
    "test:lighthouse:local": "playwright test tests/smoke/lighthouse.homepage.spec.ts",
    "start:prod:test": "next start -p 3000",
    "test:lighthouse:prod": "npm run build && node tests/tools/run-lighthouse-prod.js",
    "validate:items": "tsx src/scripts/validateItems.ts",
    "normalize:items": "tsx src/scripts/normalizeItems.ts",
    "validate:contract:home": "npm run build && npm run check:bundle && npm run test:contract:home && npm run lighthouse:home:mobile && npm run lighthouse:home:desktop && npm run report:contract:home"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "dotenv": "^17.2.3",
    "framer-motion": "12.23.24",
    "gray-matter": "4.0.3",
    "marked": "17.0.1",
    "next": "16.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@next/bundle-analyzer": "^16.1.1",
    "@playwright/test": "1.57.0",
    "@types/marked": "6.0.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "baseline-browser-mapping": "^2.9.11",
    "chrome-launcher": "0.15.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.4",
    "lighthouse": "12.3.0",
    "playwright": "1.57.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
