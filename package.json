{
  "name": "greenpax-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Edge versions",
      "last 2 Safari versions",
      "last 2 Firefox versions"
    ],
    "development": [
      "last 1 Chrome version"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build:prod": "next build",
    "start:prod": "next start -p 3000",
    "lint": "next lint",
    "check:bundle": "tsx src/scripts/checkBundleSize.ts",
    "analyze:bundle": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build && npx source-map-explorer \".next/static/chunks/**/*.js\" --html bundle-report.html",
    "test:contracts": "playwright test tests/contracts",
    "test:contract:home": "playwright test tests/contracts/home.contract.spec.ts",
    "test:smoke": "playwright test tests/smoke",
    "test:lighthouse:local": "playwright test tests/smoke/lighthouse.homepage.spec.ts",
    "lighthouse:home:mobile": "node tests/tools/run-lighthouse-prod.js mobile",
    "lighthouse:home:desktop": "node tests/tools/run-lighthouse-prod.js desktop",
    "report:contract:home": "tsx src/scripts/generateContractReport.ts",
    "validate:contract:home": "npm run build:prod && npm run check:bundle && npm run test:contract:home && cross-env LH_URL=http://localhost:3000 npm run lighthouse:home:mobile && cross-env LH_URL=http://localhost:3000 npm run lighthouse:home:desktop && npm run report:contract:home",
    "validate:items": "tsx src/scripts/validateItems.ts",
    "normalize:items": "tsx src/scripts/normalizeItems.ts"
  },
  "scriptsHelp": {
    "core lifecycle": "dev, build:prod, start:prod",
    "lint": "linting via next lint",
    "bundle": "check:bundle, analyze:bundle",
    "tests": "test:contracts, test:contract:home, test:smoke, test:lighthouse:local",
    "lighthouse": "lighthouse:home:mobile, lighthouse:home:desktop — requires LH_URL to point at a running server",
    "reports": "report:contract:home",
    "validation": "validate:contract:home runs build, bundle check, contract tests, lighthouse against LH_URL and report",
    "data hygiene": "validate:items, normalize:items"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "framer-motion": "12.23.24",
    "gray-matter": "4.0.3",
    "marked": "17.0.1",
    "next": "16.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.57.0",
    "@types/marked": "6.0.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "chrome-launcher": "0.15.2",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.4",
    "lighthouse": "12.3.0",
    "playwright": "1.57.0",
    "source-map-explorer": "^2.5.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "wait-on": "^7.2.0"
  }
}
