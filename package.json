    "next": "16.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.57.0",
    "@types/marked": "6.0.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "baseline-browser-mapping": "^2.9.11",
    "chrome-launcher": "0.15.2",
    "eslint": "9.39.1",
