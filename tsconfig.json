{
  "compilerOptions": {
    /* ------------------------------------------------------------------ */
    /* Core                                                                */
    /* ------------------------------------------------------------------ */
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    /* ------------------------------------------------------------------ */
    /* Strictness & Safety                                                 */
    /* ------------------------------------------------------------------ */
    "strict": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    /* ------------------------------------------------------------------ */
    /* Interop                                                             */
    /* ------------------------------------------------------------------ */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    /* ------------------------------------------------------------------ */
    /* JavaScript Handling                                                 */
    /* ------------------------------------------------------------------ */
    "allowJs": false,
    "checkJs": false,
    /* ------------------------------------------------------------------ */
    /* Performance                                                         */
    /* ------------------------------------------------------------------ */
    "skipLibCheck": true,
    "incremental": true,
    /* ------------------------------------------------------------------ */
    /* Next.js                                                             */
    /* ------------------------------------------------------------------ */
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* ------------------------------------------------------------------ */
    /* Path Aliases                                                        */
    /* ------------------------------------------------------------------ */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@types/*": [
        "src/types/*"
      ],
      "@data/*": [
        "src/data/*"
      ],
      "@constants/*": [
        "src/components/Common/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tests/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
